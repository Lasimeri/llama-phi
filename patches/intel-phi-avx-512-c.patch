diff --git a/tools/q4_0-bench.S b/tools/q4_0-bench.S
new file mode 100644
index 0000000..f0b4438
--- /dev/null
+++ b/tools/q4_0-bench.S
@@ -0,0 +1,258 @@
+# q4_0-bench.S: cycles per call of the Q4_0 one-row kernels and of their parts,
+# one thread, every operand in the first-level cache (the stride argument
+# is 0, so the kernels' prefetches hit the lines they are working on).
+# Static, no libc; prints "name cycles-per-call" lines. Runs on the card.
+	.include "mvex.inc"
+
+	.set N, 200000
+
+	.bss
+	.balign 64
+wblk:	.skip 4096			# a weight superblock (and what follows it)
+xs:	.skip 4096			# activations / a prepared superblock
+acc:	.skip 512
+scratch:	.skip 512
+line:	.skip 64
+
+	.data
+	.balign 64
+consts:	.float 16.0, 4.0, 2.0
+	.float 0.5, 0.25, 0.125, 0.0625, 0.03125, 0.015625, 0.0078125, 0.00390625
+	.float 8.0
+	.fill 4, 4, 0
+
+	.text
+# say(rsi name, rax value): "name value\n" to standard output.
+say:
+	pushq %rbx
+	pushq %r12
+	movq %rax, %r12
+	leaq line(%rip), %rbx
+	xorl %ecx, %ecx
+1:	movb (%rsi,%rcx), %al
+	testb %al, %al
+	jz 2f
+	movb %al, (%rbx,%rcx)
+	incq %rcx
+	jmp 1b
+2:	movb $' ', (%rbx,%rcx)
+	incq %rcx
+	leaq 20(%rbx,%rcx), %rdi		# digits written backwards from here
+	movq %rdi, %r8
+	movq %r12, %rax
+	movl $10, %r9d
+3:	xorl %edx, %edx
+	divq %r9
+	addb $'0', %dl
+	decq %rdi
+	movb %dl, (%rdi)
+	testq %rax, %rax
+	jnz 3b
+4:	cmpq %r8, %rdi
+	jae 5f
+	movb (%rdi), %al
+	movb %al, (%rbx,%rcx)
+	incq %rcx
+	incq %rdi
+	jmp 4b
+5:	movb $'\n', (%rbx,%rcx)
+	incq %rcx
+	movl $1, %eax
+	movl $1, %edi
+	movq %rbx, %rsi
+	movq %rcx, %rdx
+	syscall
+	popq %r12
+	popq %rbx
+	ret
+
+# TIME name, body: the body N times between two rdtsc, cycles per pass said.
+	.macro TIME name
+	.section .rodata
+7:	.asciz "\name"
+	.text
+	leaq 7b(%rip), %r15
+	movl $N, %r14d
+	rdtsc
+	shlq $32, %rdx
+	orq %rdx, %rax
+	movq %rax, %r13
+	.endm
+	.macro TIME_END
+	decl %r14d
+	jnz 8b
+	rdtsc
+	shlq $32, %rdx
+	orq %rdx, %rax
+	subq %r13, %rax
+	xorl %edx, %edx
+	movl $N, %ecx
+	divq %rcx
+	movq %r15, %rsi
+	call say
+	.endm
+	.macro ARGS
+	leaq wblk(%rip), %rdi
+	leaq xs(%rip), %rsi
+	leaq scratch(%rip), %rcx
+	leaq acc(%rip), %r8
+	leaq consts(%rip), %r9
+	.endm
+
+	.globl _start
+_start:
+	andq $-64, %rsp
+	# weights: bytes 0x53 (lo 3, hi 5), scales a float16 1.0 (0x3c00) per block
+	leaq wblk(%rip), %rdi
+	movl $4096, %ecx
+	movb $0x53, %al
+	rep stosb
+	leaq wblk(%rip), %rdi
+	xorl %ecx, %ecx
+1:	movw $0x3c00, (%rdi,%rcx)
+	addq $18, %rcx
+	cmpq $1152, %rcx
+	jb 1b
+
+	TIME "phi_q4_0_1_(old,_114_ops)"
+8:	ARGS
+	pushq $0
+	call phi_q4_0_1
+	addq $8, %rsp
+	TIME_END
+
+
+	TIME "phi_q4_0_row1p_one_superblock_(6_prefetch)"
+8:	ARGS
+	movl $1, %edx
+	xorl %ecx, %ecx				# no jump: the prefetch stays on these lines
+	call phi_q4_0_row1p
+	TIME_END
+
+	TIME "empty_call_and_args"
+8:	ARGS
+	call nothing
+	TIME_END
+
+	TIME "16_unpack_loads_uint8_(4_lo_then_4_hi)"
+8:	ARGS
+	.irp g, 0, 72
+	VLOADUNPACKLPS zmm8, rdi, (\g+2), conv=CV_U8
+	VLOADUNPACKLPS zmm9, rdi, (\g+20), conv=CV_U8
+	VLOADUNPACKLPS zmm10, rdi, (\g+38), conv=CV_U8
+	VLOADUNPACKLPS zmm11, rdi, (\g+56), conv=CV_U8
+	VLOADUNPACKHPS zmm8, rdi, (\g+66), conv=CV_U8
+	VLOADUNPACKHPS zmm9, rdi, (\g+84), conv=CV_U8
+	VLOADUNPACKHPS zmm10, rdi, (\g+102), conv=CV_U8
+	VLOADUNPACKHPS zmm11, rdi, (\g+120), conv=CV_U8
+	.endr
+	TIME_END
+
+	TIME "8_unpack_lo_only_uint8"
+8:	ARGS
+	.irp g, 0, 72
+	VLOADUNPACKLPS zmm8, rdi, (\g+2), conv=CV_U8
+	VLOADUNPACKLPS zmm9, rdi, (\g+20), conv=CV_U8
+	VLOADUNPACKLPS zmm10, rdi, (\g+38), conv=CV_U8
+	VLOADUNPACKLPS zmm11, rdi, (\g+56), conv=CV_U8
+	.endr
+	TIME_END
+
+	TIME "8_aligned_loads_uint8_(vmovaps)"
+8:	ARGS
+	.irp g, 0, 64
+	VMOVAPS zmm8, rdi, (\g), conv=CV_U8
+	VMOVAPS zmm9, rdi, (\g+16), conv=CV_U8
+	VMOVAPS zmm10, rdi, (\g+32), conv=CV_U8
+	VMOVAPS zmm11, rdi, (\g+48), conv=CV_U8
+	.endr
+	TIME_END
+
+	TIME "8_vbroadcastss_float16"
+8:	ARGS
+	.irp g, 0, 72
+	VBROADCASTSS zmm16, rdi, (\g), conv=CV_F16
+	VBROADCASTSS zmm17, rdi, (\g+18), conv=CV_F16
+	VBROADCASTSS zmm18, rdi, (\g+36), conv=CV_F16
+	VBROADCASTSS zmm19, rdi, (\g+54), conv=CV_F16
+	.endr
+	TIME_END
+
+	TIME "8_vmulps_1to16_and_8_vrndfxpntps"
+8:	ARGS
+	.rept 2
+	VMULPS zmm12, zmm8, r9, 24, conv=CV_1TO16
+	VMULPS zmm13, zmm9, r9, 24, conv=CV_1TO16
+	VMULPS zmm14, zmm10, r9, 24, conv=CV_1TO16
+	VMULPS zmm15, zmm11, r9, 24, conv=CV_1TO16
+	VRNDFXPNTPS zmm12, zmm12, 1
+	VRNDFXPNTPS zmm13, zmm13, 1
+	VRNDFXPNTPS zmm14, zmm14, 1
+	VRNDFXPNTPS zmm15, zmm15, 1
+	.endr
+	TIME_END
+
+	TIME "8_vmulps_1to16_only"
+8:	ARGS
+	.rept 2
+	VMULPS zmm12, zmm8, r9, 24, conv=CV_1TO16
+	VMULPS zmm13, zmm9, r9, 24, conv=CV_1TO16
+	VMULPS zmm14, zmm10, r9, 24, conv=CV_1TO16
+	VMULPS zmm15, zmm11, r9, 24, conv=CV_1TO16
+	.endr
+	TIME_END
+
+	TIME "16_fma_with_memory_operands"
+8:	ARGS
+	.irp g, 0, 512
+	VMULPS zmm8, zmm8, rsi, (\g)
+	VMULPS zmm9, zmm9, rsi, (\g+128)
+	VMULPS zmm10, zmm10, rsi, (\g+256)
+	VMULPS zmm11, zmm11, rsi, (\g+384)
+	VFMADD231PS zmm8, zmm12, rsi, (\g+64)
+	VFMADD231PS zmm9, zmm13, rsi, (\g+192)
+	VFMADD231PS zmm10, zmm14, rsi, (\g+320)
+	VFMADD231PS zmm11, zmm15, rsi, (\g+448)
+	.endr
+	TIME_END
+
+	TIME "8_vsubps_4to16"
+8:	ARGS
+	.irp g, 0, 64
+	VSUBPS zmm8, zmm8, rsi, (1024+\g), conv=CV_4TO16
+	VSUBPS zmm9, zmm9, rsi, (1040+\g), conv=CV_4TO16
+	VSUBPS zmm10, zmm10, rsi, (1056+\g), conv=CV_4TO16
+	VSUBPS zmm11, zmm11, rsi, (1072+\g), conv=CV_4TO16
+	.endr
+	TIME_END
+
+	TIME "8_fma_register"
+8:	ARGS
+	.rept 2
+	VFMADD231PS zmm0, zmm8, zmm16
+	VFMADD231PS zmm1, zmm9, zmm17
+	VFMADD231PS zmm2, zmm10, zmm18
+	VFMADD231PS zmm3, zmm11, zmm19
+	.endr
+	TIME_END
+
+	TIME "8_prefetches_of_lines_in_L1"
+8:	ARGS
+	VPREFETCH0 rdi, 0
+	VPREFETCH0 rdi, 64
+	VPREFETCH0 rdi, 128
+	VPREFETCH0 rdi, 192
+	VPREFETCH1 rdi, 0
+	VPREFETCH1 rdi, 64
+	VPREFETCH1 rdi, 128
+	VPREFETCH1 rdi, 192
+	TIME_END
+
+	movl $60, %eax
+	xorl %edi, %edi
+	syscall
+
+nothing:
+	ret
+
+	.include "q4_0.S"		# tools/q4_0-kernels.c's output (q4_0-bench.sh makes it)
diff --git a/tools/q4_0-bench.md b/tools/q4_0-bench.md
new file mode 100644
index 0000000..a5f0449
--- /dev/null
+++ b/tools/q4_0-bench.md
@@ -0,0 +1,62 @@
+# q4_0-bench.S, q4_0-bench.sh
+
+Two card programs that time the Q4_0 one-row kernels outside the
+worker, and the script that builds and runs them. They exist because
+the service's own numbers could not say why a kernel with a third
+fewer instructions was no faster (`card/vpu/rows.md`, "Q4_0 against one
+row": the answer was in the worker's trace, but these ruled out the
+instructions and the memory first).
+
+```
+tools/q4_0-bench.sh OUT_DIR [CARD]
+```
+
+The card must have no other program on it (a parked worker is fine; a
+serving one is not). The script generates the kernels
+(`tools/q4_0-kernels.c`), builds, puts three binaries in the card's
+`/tmp`, runs them through `phi`, and removes them.
+
+## q4_0-bench.S
+
+One thread, 200000 calls of each case between two `rdtsc`, every
+operand in the first-level cache (a kernel's stride argument is 0, so
+its prefetches hit the lines it is working on). It prints
+`name cycles` lines; the name's underscores stand for spaces. Static,
+no C library: `_start`, `write` and `exit` by system call.
+
+Measured on card 0 (a 7120A), 2026-11-09, the script run twice
+(`OUT_DIR/q4_0-bench.log`; a run takes 3.5 s in all):
+
+| case | cycles a call |
+| --- | --- |
+| `phi_q4_0_1`, one superblock (114 vector operations) | 306, 306 |
+| `phi_q4_0_row1p`, one superblock (72 and six prefetches) | 204, 204 |
+| an empty call with its five arguments | 11, 11 |
+| 16 unpack loads `{uint8}` (four low halves, then four high) | 40, 40 |
+| 8 low halves only | 24, 24 |
+| 8 aligned `vmovaps {uint8}` | 24, 24 |
+| 8 `vbroadcastss {float16}` | 24, 24 |
+| 8 `vmulps {1to16}` and 8 `vrndfxpntps` | 40, 40 |
+| 8 `vmulps {1to16}` | 24, 24 |
+| 16 multiplies and FMAs with memory operands | 40, 40 |
+| 8 `vsubps {4to16}` | 24, 24 |
+| 8 register FMAs | 24, 24 |
+| 8 prefetches of lines already in the cache | 24, 24 |
+
+The row kernel measured 196 and 201 before it had its jump argument
+(the compare and the add that steer the prefetch pointer are the
+difference), and `phi_q4_0_1` 324 in one earlier run.
+
+Eight vector operations of any kind are about 13 cycles past the call:
+a lone thread issues one about every other cycle, and nothing here is
+slower than that.
+
+## The streams
+
+`q4_0-stream.S` (its own document) is run alone for the prefetch
+distances and, built with an 8 MiB buffer, as one to four streams on
+each of 40 cores, pinned with the card's `taskset` to hardware threads
+in the pool's order (0, 3, 1, 2). Each stream is a process with a
+prepared row of its own, which the worker's threads of a core do not
+have (`q4_0-stream.md` has the numbers and what they do and do not say
+about the worker).
diff --git a/tools/q4_0-bench.sh b/tools/q4_0-bench.sh
new file mode 100755
index 0000000..cc484e4
--- /dev/null
+++ b/tools/q4_0-bench.sh
@@ -0,0 +1,50 @@
+#!/usr/bin/env bash
+# q4_0-bench.sh OUT_DIR [CARD]: builds the two Q4_0 one-row benchmarks
+# (q4_0-bench.S: the kernels and their parts on first-level-cache data;
+# q4_0-stream.S: the row kernel streaming a weight buffer at several
+# prefetch distances) and runs them on a card through `phi`. Needs GNU
+# as and ld, tcc, and a card with no other program on it.
+#
+#   OUT_DIR/q4_0-bench.log    cycles per call
+#   OUT_DIR/q4_0-stream.log   tenths of a cycle per superblock
+#   OUT_DIR/q4_0-many.log     the row kernel as 1 to 4 streams a core on 40 cores
+set -euo pipefail
+out=${1:?usage: q4_0-bench.sh OUT_DIR [CARD]}
+card=${2:-0}
+here=$(cd "$(dirname "$0")" && pwd)
+vpu=$here/../card/vpu
+mkdir -p "$out"
+tcc -run "$here/q4_0-kernels.c" > "$out/q4_0.S"
+
+# the row kernel alone, then one copy per prefetch pair (0: none)
+awk '/^# phi_q4_0_row1p:/ { p = 1 } p { print } /size phi_q4_0_row1p,/ { p = 0 }' "$out/q4_0.S" > "$out/row.S"
+variant() {     # name, first-level distance, second-level distance
+    sed -e "s/phi_q4_0_row1p/$1/g" "$out/row.S" | awk -v a="$2" -v b="$3" '
+        /lea 576\(%rdi\), %r10/ { printf "    lea %d(%%rdi), %%r10\n", (a == 0 ? 576 : a); next }
+        /VPREFETCH0 r10, / { if (a == 0) next }
+        /VPREFETCH1 rdi, / { if (b == 0) next; split($0, f, ","); printf "\tVPREFETCH1 rdi, %d\n", f[2] - 2304 + b; next }
+        { print }'
+}
+{ variant kv_none 0 0; variant kv_576_2304 576 2304; variant kv_288_1152 288 1152
+  variant kv_1152_4608 1152 4608; variant kv_1152_8640 1152 8640; variant kv_2304_11520 2304 11520
+  variant kv_0_2304 0 2304; variant kv_576_0 576 0; } > "$out/q4_0-variants.S"
+
+build() {       # source, binary, extra assembler arguments
+    as --64 "${@:3}" -I "$vpu" -I "$out" -o "$out/$2.o" "$here/$1"
+    ld -static -nostdlib -e _start -z noexecstack -o "$out/$2" "$out/$2.o"
+}
+build q4_0-bench.S q4_0-bench
+build q4_0-stream.S q4_0-stream
+build q4_0-stream.S q4_0-stream8 --defsym BIG=8388608
+
+for b in q4_0-bench q4_0-stream q4_0-stream8; do
+    phi -c "$card" put "$out/$b" "/tmp/$b" < /dev/null > /dev/null
+done
+phi -c "$card" run sh -c 'chmod +x /tmp/q4_0-bench; /tmp/q4_0-bench' < /dev/null > "$out/q4_0-bench.log"
+phi -c "$card" run sh -c 'chmod +x /tmp/q4_0-stream; /tmp/q4_0-stream' < /dev/null > "$out/q4_0-stream.log"
+# 1 to 4 streams on each of 40 cores (hardware threads in the pool's order 0, 3, 1, 2)
+phi -c "$card" run sh -c 'chmod +x /tmp/q4_0-stream8
+for per in 1 2 3 4; do i=0; while [ $i -lt 40 ]; do n=0; for h in 1 4 2 3; do n=$((n + 1)); if [ $n -le $per ]; then taskset -c $((4 * i + h)) /tmp/q4_0-stream8 > /tmp/o.$i.$h & fi; done; i=$((i + 1)); done; wait
+echo "$per a core:"; cat /tmp/o.* | grep pf_576_2304_step1; rm -f /tmp/o.*; done' < /dev/null > "$out/q4_0-many.log"
+phi -c "$card" run sh -c 'rm -f /tmp/q4_0-bench /tmp/q4_0-stream /tmp/q4_0-stream8' < /dev/null
+tail -n 3 "$out/q4_0-bench.log"
diff --git a/tools/q4_0-kernels.c b/tools/q4_0-kernels.c
new file mode 100644
index 0000000..05145f2
--- /dev/null
+++ b/tools/q4_0-kernels.c
@@ -0,0 +1,222 @@
+/* q4_0-kernels.c: prints the six Q4_0 kernels of card/vpu/kernels.S.
+ *
+ *   tcc -run tools/q4_0-kernels.c > q4_0.S
+ *
+ * phi_q4_0_{1,4,8} and their float16 twins phi_q4_0_{1,4,8}h, each one
+ * superblock (eight 18-byte Q4_0 blocks, 256 weights) of a weight row
+ * against 1, 4 or 8 activation rows, in the calling convention and the
+ * line format of kernels.S (the MVEX macro that assembles, then the
+ * instruction in Intel syntax as a comment). See q4_0-kernels.md. */
+#include <stdio.h>
+
+static const char *base[8] = { "rsi", "r10", "r11", "rax", "rbx", "r13", "r14", "r15" };
+
+/* one weight vector `w` (a zmm number) times its sixteen activations of
+ * every row, at vector index v of the superblock */
+static void products(int rows, int half, int w, int v)
+{
+    int off = v * (half ? 32 : 64);
+    for (int q = 0; q < rows; q++) {
+        int acc = rows == 1 ? v & 3 : q;
+        printf("\tVFMADD231PS zmm%d, zmm%d, %s, %d%s\t# vfmadd231ps zmm%d, zmm%d, [%s+%d]%s\n",
+               acc, w, base[q], off, half ? ", conv=CV_F16" : "",
+               acc, w, base[q], off, half ? "{float16}" : "");
+    }
+}
+
+static void kernel(int rows, int half)
+{
+    char name[32];
+    snprintf(name, sizeof name, "phi_q4_0_%d%s", rows, half ? "h" : "");
+    printf("# %s: eight Q4_0 blocks, against %d activation row(s)%s\n", name, rows,
+           half ? ", float16" : "");
+    printf("    .globl %s\n    .type %s, @function\n%s:\n", name, name, name);
+
+    /* the superblock this thread processes next: L1 two calls ahead, L2 four */
+    printf("    mov 8(%%rsp), %%r11\n    lea (%%rdi,%%r11,2), %%rax\n");
+    for (int d = 0; d < 256; d += 64)
+        printf("\tVPREFETCH0 rax, %d\t# vprefetch0 [rax+%d]\n", d, d);
+    printf("    lea (%%rax,%%r11,2), %%rax\n");
+    for (int d = 0; d < 256; d += 64)
+        printf("\tVPREFETCH1 rax, %d\t# vprefetch1 [rax+%d]\n", d, d);
+    if (rows == 8)
+        printf("    push %%rbx\n    push %%r13\n    push %%r14\n    push %%r15\n");
+
+    /* the eight block scales (float16 at 18 i) into lanes 0..7, to the scratch */
+    printf("\tVPXORD zmm16, zmm16, zmm16\t# vpxord zmm16, zmm16, zmm16\n");
+    for (int i = 0; i < 8; i++) {
+        printf("    mov $%d, %%eax\n\tKMOV_KR k1, eax\t# kmov k1, eax\n", 1 << i);
+        printf("\tVLOADUNPACKLPS zmm16, rdi, %d, conv=CV_F16, k=k1\t# vloadunpacklps zmm16 {k1}, [rdi+%d]{float16}\n",
+               18 * i, 18 * i);
+        printf("\tVLOADUNPACKHPS zmm16, rdi, %d, conv=CV_F16, k=k1\t# vloadunpackhps zmm16 {k1}, [rdi+%d]{float16}\n",
+               18 * i + 64, 18 * i + 64);
+    }
+    printf("\tVMOVAPS_ST rcx, 0, zmm16\t# vmovaps [rcx+0], zmm16\n");
+
+    /* the other activation rows, the accumulators */
+    for (int q = 1; q < rows; q++)
+        printf("    mov %d(%%rdx), %%%s\n", 8 * q, base[q]);
+    if (rows == 1) {
+        printf("\tVMOVAPS zmm0, r8, 0\t# vmovaps zmm0, [r8+0]\n");
+        for (int a = 1; a < 4; a++)
+            printf("\tVPXORD zmm%d, zmm%d, zmm%d\t# vpxord zmm%d, zmm%d, zmm%d\n", a, a, a, a, a, a);
+    } else {
+        for (int q = 0; q < rows; q++)
+            printf("\tVMOVAPS zmm%d, r8, %d\t# vmovaps zmm%d, [r8+%d]\n", q, 64 * q, q, 64 * q);
+    }
+
+    /* two batches of four blocks: zmm8..11 the bytes and then the low
+     * nibbles, zmm12..15 the high nibbles; every stage for the whole batch */
+    for (int g = 0; g < 2; g++) {
+        for (int j = 0; j < 4; j++) {
+            int o = 18 * (4 * g + j) + 2;
+            printf("\tVLOADUNPACKLPS zmm%d, rdi, %d, conv=CV_U8\t# vloadunpacklps zmm%d, [rdi+%d]{uint8}\n",
+                   8 + j, o, 8 + j, o);
+            printf("\tVLOADUNPACKHPS zmm%d, rdi, %d, conv=CV_U8\t# vloadunpackhps zmm%d, [rdi+%d]{uint8}\n",
+                   8 + j, o + 64, 8 + j, o + 64);
+        }
+        for (int j = 0; j < 4; j++)     /* b * 2^-4 */
+            printf("\tVMULPS zmm%d, zmm%d, r9, 24, conv=CV_1TO16\t# vmulps zmm%d, zmm%d, [r9+24]{1to16}\n",
+                   12 + j, 8 + j, 12 + j, 8 + j);
+        for (int j = 0; j < 4; j++)     /* its floor: the high nibble */
+            printf("\tVRNDFXPNTPS zmm%d, zmm%d, 1\t# vrndfxpntps zmm%d, zmm%d, 1\n",
+                   12 + j, 12 + j, 12 + j, 12 + j);
+        for (int j = 0; j < 4; j++)     /* b - 16 hi: the low nibble */
+            printf("\tVFNMADD231PS zmm%d, zmm%d, r9, 0, conv=CV_1TO16\t# vfnmadd231ps zmm%d, zmm%d, [r9+0]{1to16}\n",
+                   8 + j, 12 + j, 8 + j, 12 + j);
+        for (int j = 0; j < 8; j++)     /* q - 8 */
+            printf("\tVSUBPS zmm%d, zmm%d, r9, 44, conv=CV_1TO16\t# vsubps zmm%d, zmm%d, [r9+44]{1to16}\n",
+                   8 + j, 8 + j, 8 + j, 8 + j);
+        for (int j = 0; j < 8; j++) {   /* (q - 8) * d, the block's scale */
+            int d = 4 * (4 * g + (j & 3));
+            printf("\tVMULPS zmm%d, zmm%d, rcx, %d, conv=CV_1TO16\t# vmulps zmm%d, zmm%d, [rcx+%d]{1to16}\n",
+                   8 + j, 8 + j, d, 8 + j, 8 + j, d);
+        }
+        for (int j = 0; j < 4; j++) {   /* block i: weights 32 i.. low, 32 i + 16.. high */
+            int i = 4 * g + j;
+            products(rows, half, 8 + j, 2 * i);
+            products(rows, half, 12 + j, 2 * i + 1);
+        }
+    }
+
+    if (rows == 1) {
+        printf("\tVADDPS zmm0, zmm0, zmm1\t# vaddps zmm0, zmm0, zmm1\n");
+        printf("\tVADDPS zmm2, zmm2, zmm3\t# vaddps zmm2, zmm2, zmm3\n");
+        printf("\tVADDPS zmm0, zmm0, zmm2\t# vaddps zmm0, zmm0, zmm2\n");
+    }
+    for (int q = 0; q < rows; q++)
+        printf("\tVMOVAPS_ST r8, %d, zmm%d\t# vmovaps [r8+%d], zmm%d\n", 64 * q, q, 64 * q, q);
+    if (rows == 8)
+        printf("    pop %%r15\n    pop %%r14\n    pop %%r13\n    pop %%rbx\n");
+    printf("    ret\n    .size %s, .-%s\n", name, name);
+}
+
+/* phi_q4_0_row1p(row rdi, prepared rsi, ns rdx, acc r8, consts r9): a
+ * whole Q4_0 weight row of ns superblocks against one prepared
+ * activation row (card/vpu/rows.S, q4_0_prepare): per superblock 1152
+ * bytes, for block i the vectors x0 = x[32 i..] at 128 i and
+ * y = x[32 i + 16..] - 16 x0 at 128 i + 64, and four floats p at
+ * 1024 + 16 i with 4 sum(p) = 8 sum(x[32 i..32 i + 31]). With b the
+ * block's bytes and hi = floor(b / 16),
+ *
+ *   sum (lo - 8) x0 + (hi - 8) x1  =  sum b x0 + hi y - p{4to16}
+ *
+ * so neither the low nibble nor the q - 8 is computed, and the scale is
+ * one vbroadcastss of its float16: nine vector operations a block where
+ * phi_q4_0_1 has thirteen and a serial chain of sixteen masked loads.
+ * The row is one sequential stream: the lines 576 bytes ahead to the
+ * first-level cache, the lines 2304 bytes ahead to the second. The four
+ * accumulators stay in registers across the row; their sum is added to
+ * the sixteen lanes at acc (so a row may be given in segments).
+ *
+ * rcx is the jump: the distance from the end of these ns superblocks to
+ * the start of the ones the caller gives next (0 when they follow on,
+ * as a thread's whole rows do; a row's distance less 144 ns for a
+ * segment of each row). The first-level prefetch runs four superblocks
+ * ahead through r10 and takes the jump when four are left, so the last
+ * four prefetches of a call fetch the next call's first four. Keeps
+ * every general register but rax, rdx, rsi, rdi, r10. */
+static void kernel_prepared(void)
+{
+    const char *name = "phi_q4_0_row1p";
+    printf("# %s: a Q4_0 weight row, or a segment of one, against 1 prepared activation row\n", name);
+    printf("    .globl %s\n    .type %s, @function\n%s:\n", name, name, name);
+    printf("\tVMOVAPS zmm0, r8, 0\t# vmovaps zmm0, [r8+0]\n");
+    for (int a = 1; a < 4; a++)
+        printf("\tVPXORD zmm%d, zmm%d, zmm%d\t# vpxord zmm%d, zmm%d, zmm%d\n", a, a, a, a, a, a);
+    printf("    lea 576(%%rdi), %%r10\n    cmp $4, %%rdx\n    ja 1f\n    add %%rcx, %%r10\n");
+    printf("1:\n");
+    for (int d = 0; d < 192; d += 64)
+        printf("\tVPREFETCH0 r10, %d\t# vprefetch0 [r10+%d]\n", d, d);
+    for (int d = 0; d < 192; d += 64)
+        printf("\tVPREFETCH1 rdi, %d\t# vprefetch1 [rdi+%d]\n", 2304 + d, 2304 + d);
+
+    /* two batches of four blocks, every stage for the whole batch: zmm8..11
+     * the bytes and then the block's sum, zmm12..15 the high nibbles,
+     * zmm16..19 the scales */
+    for (int g = 0; g < 2; g++) {
+        for (int j = 0; j < 4; j++) {
+            int o = 18 * (4 * g + j) + 2;
+            printf("\tVLOADUNPACKLPS zmm%d, rdi, %d, conv=CV_U8\t# vloadunpacklps zmm%d, [rdi+%d]{uint8}\n",
+                   8 + j, o, 8 + j, o);
+        }
+        for (int j = 0; j < 4; j++) {
+            int o = 18 * (4 * g + j) + 2 + 64;
+            printf("\tVLOADUNPACKHPS zmm%d, rdi, %d, conv=CV_U8\t# vloadunpackhps zmm%d, [rdi+%d]{uint8}\n",
+                   8 + j, o, 8 + j, o);
+        }
+        for (int j = 0; j < 4; j++) {   /* the block's scale, to every lane */
+            int o = 18 * (4 * g + j);
+            printf("\tVBROADCASTSS zmm%d, rdi, %d, conv=CV_F16\t# vbroadcastss zmm%d, [rdi+%d]{float16}\n",
+                   16 + j, o, 16 + j, o);
+        }
+        for (int j = 0; j < 4; j++)     /* b * 2^-4 */
+            printf("\tVMULPS zmm%d, zmm%d, r9, 24, conv=CV_1TO16\t# vmulps zmm%d, zmm%d, [r9+24]{1to16}\n",
+                   12 + j, 8 + j, 12 + j, 8 + j);
+        for (int j = 0; j < 4; j++) {   /* b x0 */
+            int o = 128 * (4 * g + j);
+            printf("\tVMULPS zmm%d, zmm%d, rsi, %d\t# vmulps zmm%d, zmm%d, [rsi+%d]\n",
+                   8 + j, 8 + j, o, 8 + j, 8 + j, o);
+        }
+        for (int j = 0; j < 4; j++)     /* the floor: the high nibble */
+            printf("\tVRNDFXPNTPS zmm%d, zmm%d, 1\t# vrndfxpntps zmm%d, zmm%d, 1\n",
+                   12 + j, 12 + j, 12 + j, 12 + j);
+        for (int j = 0; j < 4; j++) {   /* + hi y */
+            int o = 128 * (4 * g + j) + 64;
+            printf("\tVFMADD231PS zmm%d, zmm%d, rsi, %d\t# vfmadd231ps zmm%d, zmm%d, [rsi+%d]\n",
+                   8 + j, 12 + j, o, 8 + j, 12 + j, o);
+        }
+        for (int j = 0; j < 4; j++) {   /* - p */
+            int o = 1024 + 16 * (4 * g + j);
+            printf("\tVSUBPS zmm%d, zmm%d, rsi, %d, conv=CV_4TO16\t# vsubps zmm%d, zmm%d, [rsi+%d]{4to16}\n",
+                   8 + j, 8 + j, o, 8 + j, 8 + j, o);
+        }
+        for (int j = 0; j < 4; j++)     /* times the scale, into four accumulators */
+            printf("\tVFMADD231PS zmm%d, zmm%d, zmm%d\t# vfmadd231ps zmm%d, zmm%d, zmm%d\n",
+                   j, 8 + j, 16 + j, j, 8 + j, 16 + j);
+    }
+    printf("    add $144, %%rdi\n    add $144, %%r10\n    add $1152, %%rsi\n    dec %%rdx\n");
+    printf("    cmp $4, %%rdx\n    jne 2f\n    add %%rcx, %%r10\n2:\n    test %%rdx, %%rdx\n    jnz 1b\n");
+    printf("\tVADDPS zmm0, zmm0, zmm1\t# vaddps zmm0, zmm0, zmm1\n");
+    printf("\tVADDPS zmm2, zmm2, zmm3\t# vaddps zmm2, zmm2, zmm3\n");
+    printf("\tVADDPS zmm0, zmm0, zmm2\t# vaddps zmm0, zmm0, zmm2\n");
+    printf("\tVMOVAPS_ST r8, 0, zmm0\t# vmovaps [r8+0], zmm0\n");
+    printf("    ret\n    .size %s, .-%s\n", name, name);
+}
+
+int main(void)
+{
+    printf("# The Q4_0 kernels (2026-11-09): the output of tools/q4_0-kernels.c.\n"
+           "# A block is 18 bytes, the float16 scale d and sixteen bytes whose low\n"
+           "# nibbles are weights 0..15 and whose high nibbles are weights 16..31, each\n"
+           "# (q - 8) * d (ggml's dequantize_row_q4_0); eight blocks a call.\n");
+    for (int half = 0; half < 2; half++)
+        for (int rows = 1; rows <= 8; rows = rows == 1 ? 4 : 8 + (rows == 8)) {
+            if (half || rows > 1)
+                printf("\n");           /* a blank line between kernels, none after the last */
+            kernel(rows, half);
+        }
+    printf("\n");
+    kernel_prepared();
+    return 0;
+}
